		"json-schema-to-typescript": "^13.1.2",
		"leaflet": "^1.9.4",
		"path": "^0.12.7",
		"postcss": "^8.4.35",
		"prettier": "^3.2.5",
		"prettier-plugin-tailwindcss": "^0.5.11",
		"react-leaflet": "^4.2.1",
		"tailwindcss": "^3.4.1",
		"typescript": "^5.3.3",
		"vite": "^5.1.1"
	}
}