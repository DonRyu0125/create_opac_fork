{
	"name": "my-app",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"setup": "pnpm install && pnpm add -g docsify",
		"start": "pnpm gen && craco start",
		"build": "vite build",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"format": "prettier --plugin-search-dir=. --write .",
		"gen:schema": "node ./tools/gen-schema.mjs",
		"gen:theme": "node ./tools/gen-theme.mjs",
		"gen:types": "node ./tools/gen-types.mjs",
		"gen": " pnpm run gen:theme && pnpm run gen:types",
		"doc": "docsify serve docs"
	},
	"dependencies": {
		"@icons-pack/react-simple-icons": "^9.3.0",
