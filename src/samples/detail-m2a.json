			"label_txt_group": {
				"label_txt_group_occurrence": {
					"label_text": "Try squares like this are very tools in wood working shops. \nThey are used to mark lines perpendicularly to an edge, and to check the\nsquareness of corners.  The blade is attached beyond the edge of the stock\nfor more accurate marking.  This tool is sometimes mislabelled as a “tri\nsquare”; it is called a “try square” because they were originally designed to\ntest or “try” square corners.\nHistorically, many of these tools were made by a tradesman himself, but since\nthe 18th century the vast majority are factory produced.",
					"label_txt_author": "Jamieson, Spencer",
					"public": "Y"
				}
			},
